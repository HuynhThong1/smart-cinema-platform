API_ADDR=127.0.0.1:8080
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=smart_cinema
OIDC_ISSUER=http://localhost:8081/realms/smart-cinema
OIDC_AUDIENCE=smart-cinema-api
PUBLIC_URL=http://localhost:4201
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4201,http://127.0.0.1:4201
IP_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters
SEED_DEVELOPMENT=true
TRUSTED_PROXIES=127.0.0.1,::1
KEYCLOAK_SERVICE_CLIENT=smart-cinema-service
KEYCLOAK_SERVICE_SECRET=local-service-secret-change-before-deployment

# Manager feedback notifications. In-app notifications are always persisted.
# Email remains queued until enabled; jobs older than 12 hours expire safely.
ADMIN_URL=http://localhost:4200
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_FROM='Smart Cinema <alerts@example.test>'
RESEND_API_KEY=
